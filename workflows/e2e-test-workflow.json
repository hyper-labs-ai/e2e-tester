{
  "name": "e2e-test-workflow",
  "version": "1.0",
  "description": "End-to-End testing workflow: generate E2E test plans, execute them, and report results",
  "config": {
    "parallelLimit": 2,
    "continueOnError": true,
    "timeout": 3600,
    "maxRetries": 2
  },
  "inputs": {
    "target_url": {
      "type": "string",
      "required": false,
      "default": "http://localhost:5173",
      "description": "URL of the application to test"
    },
    "scope": {
      "type": "string",
      "required": false,
      "default": "auto",
      "description": "Scope of testing: 'auto' (discover), 'all', or comma-separated subproject names"
    },
    "mode": {
      "type": "string",
      "required": false,
      "default": "execute",
      "description": "What to do: create plans, execute plans, or both",
      "enum": ["create", "execute", "both"]
    },
    "auth_method": {
      "type": "string",
      "required": false,
      "default": "interactive",
      "description": "Authentication method for test execution",
      "enum": ["interactive", "static", "none"]
    },
    "issue_handling": {
      "type": "string",
      "required": false,
      "default": "report",
      "description": "How to handle issues discovered during testing",
      "enum": ["report", "fix"]
    }
  },
  "nodes": [
    {
      "id": "discover_project",
      "type": "primitive",
      "primitive": "e2e-tester",
      "description": "Scan the project to discover structure and existing plans",
      "inputs": {
        "mode": "create"
      }
    },
    {
      "id": "execute_tests",
      "type": "primitive",
      "primitive": "e2e-tester",
      "description": "Execute E2E test plans",
      "inputs": {
        "mode": "execute",
        "target_url": "{{inputs.target_url}}"
      }
    },
    {
      "id": "generate_report",
      "type": "primitive",
      "primitive": "e2e-tester",
      "description": "Generate comprehensive test execution report",
      "inputs": {
        "mode": "execute"
      }
    }
  ],
  "edges": [
    { "from": "discover_project", "to": "execute_tests" },
    { "from": "execute_tests", "to": "generate_report" }
  ],
  "output": {
    "summary": "{{execute_tests.summary}}",
    "tests_executed": "{{execute_tests.plans_executed.length}}",
    "passed": "{{execute_tests.test_results.passed}}",
    "failed": "{{execute_tests.test_results.failed}}",
    "issues": "{{execute_tests.test_results.issues_filed}}",
    "report": "{{generate_report.report_file}}"
  }
}
