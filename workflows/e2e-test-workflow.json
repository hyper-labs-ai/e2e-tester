{
  "name": "e2e-test-workflow",
  "version": "2.0",
  "description": "End-to-End testing workflow: execute existing E2E test plans or generate new ones, run them, and report results",
  "config": {
    "parallelLimit": 1,
    "continueOnError": true,
    "timeout": 7200,
    "maxRetries": 1
  },
  "inputs": {
    "target_url": {
      "type": "string",
      "required": false,
      "default": "http://localhost:5173",
      "description": "URL of the application to test"
    },
    "mode": {
      "type": "string",
      "required": false,
      "default": "execute",
      "description": "What to do: execute plans, or both (create if empty + execute)",
      "enum": ["execute", "both"]
    },
    "scope": {
      "type": "string",
      "required": false,
      "default": "all",
      "description": "Which plans to run: 'all' or comma-separated plan names"
    },
    "auth_method": {
      "type": "string",
      "required": false,
      "default": "interactive",
      "description": "Authentication method for test execution",
      "enum": ["interactive", "static", "none"]
    },
    "issue_handling": {
      "type": "string",
      "required": false,
      "default": "report",
      "description": "How to handle issues discovered during testing",
      "enum": ["report", "fix"]
    }
  },
  "nodes": [
    {
      "id": "check_plans",
      "type": "primitive",
      "primitive": "e2e-tester",
      "description": "Check for existing plans and execute or create them",
      "inputs": {
        "mode": "{{inputs.mode === 'both' ? 'execute' : inputs.mode}}",
        "target_url": "{{inputs.target_url}}"
      }
    }
  ],
  "edges": [],
  "output": {
    "summary": "{{check_plans.summary}}",
    "plans_created": "{{check_plans.plans_created}}",
    "plans_executed": "{{check_plans.plans_executed}}",
    "passed": "{{check_plans.test_results.passed}}",
    "failed": "{{check_plans.test_results.failed}}",
    "issues": "{{check_plans.test_results.issues_filed}}",
    "report": "{{check_plans.report_file}}"
  }
}
